# Copy to .env and fill in.
SITE_URL=https://your-domain.com     # public address; used for search-engine links, the sitemap and share previews
ADMIN_EMAILS=you@yourdomain.com     # site owners: see website enquiries (Leads) and get an email for each one; comma-separated
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority   # Atlas; locally the default is mongodb://127.0.0.1:27017
MONGODB_DB=reachout
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME   # Cloudinary dashboard → API Keys; file storage (empty = files stay in MongoDB GridFS)
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))" — encrypts ALL stored data; never lose or change it

# Email used to send login codes (required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=Reachout <you@gmail.com>

ALLOW_SIGNUP=1          # 0 = nobody new can sign up
DAILY_LIMIT=100         # messages per user per day
MIN_WA_DELAY=20         # minimum seconds between WhatsApp messages
MAX_BROWSERS=3          # WhatsApp browsers running at once (≈300-500 MB RAM each)
MAX_CONTACTS=5000       # per user
MAX_FILES_MB=25         # storage per user

# Only when a reverse proxy (Caddy/nginx) is the ONLY way to reach the app: trust its X-Forwarded-For header.
# TRUST_PROXY=1
# Error reports to Sentry (optional): sentry.io → your project → Client Keys (DSN)
# SENTRY_DSN=
# WhatsApp sending (automates WhatsApp Web; against WhatsApp's terms, numbers can be banned). 0 = off.
# WHATSAPP_ENABLED=1
# Shown on the privacy policy and terms pages.
# OPERATOR_NAME=Your name or company
# JURISDICTION=India

# Optional: a local open-source model (Ollama) adds a short verdict to the top AI job matches.
# ollama pull qwen3:4b, then:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
